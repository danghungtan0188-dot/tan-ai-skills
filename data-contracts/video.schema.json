{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danghungtan0188-dot/tan-ai-skills/data-contracts/video.schema.json",
  "title": "Hợp đồng dữ liệu chuỗi video",
  "description": "VideoBrief → VideoInput → VideoAnalysis → EditPlan → RenderResult → VideoQAReport. VideoBrief do lệnh /dung-video viết từ gợi ý của người dùng; mỗi agent trong chuỗi nhận object trước và trả object sau.",
  "$defs": {
    "VideoBrief": {
      "type": "object",
      "description": "Bản yêu cầu: gợi ý bằng lời của người dùng → các thông số dựng rõ ràng. Lệnh /dung-video viết, người dùng duyệt ở cổng 1.",
      "required": [
        "source",
        "request",
        "video_type",
        "route",
        "unknowns",
        "gate_plan",
        "gate_final"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Thư mục hoặc file tư liệu người dùng đưa"
        },
        "request": {
          "type": "string",
          "description": "Nguyên văn gợi ý của người dùng — không tóm tắt, không sửa"
        },
        "video_type": {
          "type": "string",
          "enum": [
            "ban_tin",
            "su_kien",
            "tai_lieu",
            "mang_xa_hoi",
            "san_pham",
            "thuyet_minh",
            "tu_do"
          ]
        },
        "route": {
          "type": "string",
          "enum": [
            "dung-tu-kho",
            "video-news",
            "edit-video",
            "tan_studio"
          ],
          "description": "Cửa vào đang có sẽ thực thi; /dung-video không tự dựng"
        },
        "target_duration": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Giây; null = chưa rõ (phải nằm trong unknowns)"
        },
        "aspect_ratio": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            null
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "facebook",
            "tiktok",
            "youtube",
            "zalo",
            "reels",
            "shorts",
            "khac",
            null
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ],
          "description": "Phong cách đã chốt, vd. att-news; null = theo loại video"
        },
        "must_have": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Người dùng dặn phải có"
        },
        "must_avoid": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Người dùng dặn không được làm"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Điều chưa rõ — gom thành MỘT câu hỏi ở cổng 1, không bịa"
        },
        "cut_authorized": {
          "type": "boolean",
          "default": false,
          "description": "Người dùng đã cho phép cắt/đổi thời lượng chưa"
        },
        "gate_plan": {
          "type": "string",
          "enum": [
            "cho",
            "dong_y",
            "sua"
          ],
          "description": "Cổng duyệt 1: kế hoạch"
        },
        "gate_final": {
          "type": "string",
          "enum": [
            "chua_toi",
            "cho",
            "chap_nhan",
            "gop_y"
          ],
          "description": "Cổng duyệt 2: video"
        }
      }
    },
    "VideoInput": {
      "type": "object",
      "required": [
        "source",
        "goal"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Đường dẫn file video gốc"
        },
        "goal": {
          "type": "string",
          "description": "Người dùng muốn gì"
        },
        "target_platform": {
          "type": "string",
          "enum": [
            "facebook",
            "tiktok",
            "youtube",
            "zalo",
            "reels",
            "shorts",
            "khac"
          ]
        },
        "cut_authorized": {
          "type": "boolean",
          "default": false,
          "description": "Người dùng đã cho phép thay đổi thời lượng chưa"
        },
        "extra_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VideoAnalysis": {
      "type": "object",
      "required": [
        "source",
        "duration",
        "has_audio",
        "topic"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "aspect_ratio": {
          "type": "string",
          "examples": [
            "16:9",
            "9:16",
            "1:1"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait",
            "square"
          ]
        },
        "fps": {
          "type": "number",
          "minimum": 0
        },
        "video_codec": {
          "type": "string"
        },
        "audio_codec": {
          "type": "string"
        },
        "sample_rate": {
          "type": "integer"
        },
        "channels": {
          "type": "integer"
        },
        "rotation": {
          "type": "integer"
        },
        "bitrate": {
          "type": "integer"
        },
        "has_audio": {
          "type": "boolean"
        },
        "topic": {
          "type": "string",
          "description": "Chủ đề nhận diện được, đối chiếu bảng nhận diện của skill bien-tap-video"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Chỉ ghi điều QUAN SÁT ĐƯỢC từ contact sheet/probe, không suy đoán"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Điều chưa xác định được — bắt buộc khai báo thay vì đoán"
        },
        "clips": {
          "type": "array",
          "description": "Khi có nhiều clip: mỗi clip một bản ghi + cờ tương thích",
          "items": {
            "type": "object",
            "required": [
              "source",
              "compatible"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "compatible": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "EditPlan": {
      "type": "object",
      "required": [
        "output",
        "segments",
        "skills_used"
      ],
      "properties": {
        "output": {
          "type": "string",
          "description": "Đường dẫn file sẽ xuất ra"
        },
        "target_duration": {
          "type": "number",
          "minimum": 0
        },
        "aspect_ratio": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "purpose"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "purpose": {
                "type": "string"
              },
              "transition_in": {
                "type": "string"
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "text_overlays": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "color_grade": {
          "type": "string"
        },
        "audio_plan": {
          "type": "string"
        },
        "subtitle_plan": {
          "type": "string"
        },
        "skills_used": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skill sẽ gọi để thực thi, ví dụ video-use, hieu-ung-video"
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RenderResult": {
      "type": "object",
      "required": [
        "output",
        "command",
        "exit_code"
      ],
      "properties": {
        "output": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "Lệnh thực tế đã chạy"
        },
        "exit_code": {
          "type": "integer"
        },
        "stderr_tail": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "exit_code=0 KHÔNG có nghĩa là PASS — phải qua VideoQAReport"
        }
      }
    },
    "VideoQAReport": {
      "type": "object",
      "description": "Do scripts/video_qa.py sinh ra. Không tự viết tay.",
      "required": [
        "artifact",
        "checked_at",
        "status",
        "checks",
        "errors",
        "warnings"
      ],
      "properties": {
        "artifact": {
          "type": "string"
        },
        "checked_at": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "WARN",
            "FAIL"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "WARN",
                  "FAIL"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probe": {
          "type": "object"
        }
      }
    }
  }
}
