{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danghungtan0188-dot/tan-ai-skills/data-contracts/app.schema.json",
  "title": "Hợp đồng dữ liệu chuỗi app/website",
  "description": "FeatureRequest → ImplementationPlan → ImplementationResult → TestReport → ReviewReport. Mỗi agent nhận object trước và trả object sau.",
  "$defs": {
    "FeatureRequest": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "description": "Người dùng muốn gì, một câu" },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tiêu chí kiểm chứng được — cách biết là xong"
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ImplementationPlan": {
      "type": "object",
      "required": ["steps", "affected_files", "validation_commands"],
      "properties": {
        "understanding": { "type": "string" },
        "affected_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "change"],
            "properties": {
              "path": { "type": "string" },
              "change": { "type": "string", "enum": ["create", "modify", "delete"] },
              "why": { "type": "string" }
            }
          }
        },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["do", "verify"],
            "properties": {
              "do": { "type": "string" },
              "verify": { "type": "string", "description": "Cách xác nhận bước này xong" }
            }
          }
        },
        "validation_commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lệnh thật lấy từ package.json/Makefile của dự án, không bịa"
        },
        "risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ImplementationResult": {
      "type": "object",
      "required": ["files_changed", "plan_deviations"],
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "change"],
            "properties": {
              "path": { "type": "string" },
              "change": { "type": "string", "enum": ["create", "modify", "delete"] },
              "summary": { "type": "string" }
            }
          }
        },
        "plan_deviations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Chỗ làm khác kế hoạch và lý do. Mảng rỗng nghĩa là bám đúng kế hoạch."
        },
        "notes_out_of_scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Vấn đề phát hiện nhưng KHÔNG tự sửa"
        }
      }
    },
    "TestReport": {
      "type": "object",
      "required": ["results"],
      "description": "Mỗi hạng mục phải có command thật và exit_code thật. Chưa chạy = NOT_RUN.",
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage", "status"],
            "properties": {
              "stage": {
                "type": "string",
                "enum": ["lint", "typecheck", "unit", "integration", "build", "security"]
              },
              "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
              "command": { "type": "string" },
              "exit_code": { "type": "integer" },
              "detail": { "type": "string" },
              "reason_not_run": {
                "type": "string",
                "description": "Bắt buộc khi status = NOT_RUN"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "PASS" } } },
                "then": { "required": ["command", "exit_code"] }
              },
              {
                "if": { "properties": { "status": { "const": "NOT_RUN" } } },
                "then": { "required": ["reason_not_run"] }
              }
            ]
          }
        },
        "overall": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL"] }
      }
    },
    "ReviewReport": {
      "type": "object",
      "required": ["verdict", "findings"],
      "properties": {
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "file", "summary"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["blocker", "major", "minor", "nit"]
              },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "summary": { "type": "string" },
              "failure_scenario": {
                "type": "string",
                "description": "Input/state cụ thể → hậu quả sai. Không có kịch bản cụ thể thì không phải finding."
              },
              "suggested_fix": { "type": "string" }
            }
          }
        },
        "checked": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Đã thực sự xem những gì"
        }
      }
    }
  }
}
