# tan_studio không cần API key. Biến dưới đây là TUỲ CHỌN.
# Đặt làm biến môi trường thật (không commit file .env).

# Token Hugging Face — chỉ cần khi tải model VieNeu bị giới hạn tốc độ.
HF_TOKEN=<your-token>

# Chỉ cho lệnh `tim-canh` (tìm cảnh minh hoạ). Key miễn phí: pexels.com/api, pixabay.com/api/docs
PEXELS_API_KEY=<your-key>
PIXABAY_API_KEY=<your-key>
